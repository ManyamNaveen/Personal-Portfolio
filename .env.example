# ==========================================
# Email Configuration (100% Free)
# ==========================================
# Option 1: Gmail SMTP with App Password (Recommended & Free)
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a 16-character App Password for "Portfolio Mail"
# 3. Paste your Gmail and App Password below:
GMAIL_USER=example@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password_here

# Target inbox to receive emails (defaults to naveenmanyam12@gmail.com)
RECIPIENT_EMAIL=example@gmail.com

# Option 2: Resend (Alternative Free Tier: 3,000 emails/month)
# RESEND_API_KEY=re_123456789
